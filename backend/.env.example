# ── Postgres (Railway provides this) ──
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── ClickHouse Cloud ──
CH_HOST=your-instance.clickhouse.cloud
CH_PORT=8443
CH_USER=default
CH_PASSWORD=your-password
CH_SECURE=true
CH_DATABASE=default

# ── CDC ──
SLOT_NAME=cdc_artie_slot

# ── CORS ──
FRONTEND_URL=https://your-app.vercel.app

# ── Server (Railway sets PORT automatically) ──
# PORT=8000
